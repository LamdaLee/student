# 로컬 개발은 DATABASE_URL 이 없으면 .local/portal.sqlite 에 저장됩니다.
# Vercel 에서는 Environment Variables 에 설정하세요. 실제 값은 Git 에 올리지 마세요.
# 런치패스와 같은 Neon DB 를 씁니다. 포털 테이블은 그 안의 portal 스키마에 만들어집니다.
DATABASE_URL=
# 포털 테이블을 둘 스키마 (기본 portal, public 은 불가)
PORTAL_DB_SCHEMA=
# 런치패스와 같은 값(32자 이상 무작위). 런치패스 프로젝트에도 똑같이 넣습니다.
PORTAL_SECRET=
# 런치패스 주소 (기본: https://matzip-six.vercel.app)
LUNCHPASS_URL=
# 운영진 휴대폰 알림 키(선택). 비워 두면 포털이 처음 쓸 때 만들어 DB 에 저장합니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
